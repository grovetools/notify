{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grovetools/notify/pkg/config/notifications-config",
  "$defs": {
    "NtfyConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable ntfy.sh push notifications",
          "default": false,
          "x-important": true,
          "x-layer": "global",
          "x-priority": "70"
        },
        "topic": {
          "type": "string",
          "description": "ntfy.sh topic name for notifications",
          "x-important": true,
          "x-layer": "global",
          "x-priority": "71"
        },
        "url": {
          "type": "string",
          "description": "ntfy.sh server URL",
          "default": "https://ntfy.sh",
          "x-important": true,
          "x-layer": "global",
          "x-priority": "72"
        }
      },
      "type": "object",
      "required": [
        "enabled",
        "topic",
        "url"
      ]
    },
    "SignalConfig": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Signal messaging channel",
          "default": false,
          "x-important": true,
          "x-layer": "global",
          "x-priority": "72"
        },
        "cli_path": {
          "type": "string",
          "description": "Path to signal-cli binary",
          "default": "/usr/local/bin/signal-cli",
          "x-layer": "global",
          "x-priority": "73"
        },
        "account": {
          "type": "string",
          "description": "Signal account phone number",
          "x-important": true,
          "x-layer": "global",
          "x-priority": "74"
        },
        "allowlist": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Authorized sender phone numbers",
          "x-layer": "global",
          "x-priority": "75"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Authorized Signal group IDs (base64)",
          "x-layer": "global",
          "x-priority": "75"
        },
        "contacts": {
          "additionalProperties": {
            "$ref": "#/$defs/SignalContact"
          },
          "type": "object",
          "description": "Named contacts mapping name to phone number",
          "x-layer": "global",
          "x-priority": "75"
        },
        "agent_instructions": {
          "type": "string",
          "description": "Custom agent instructions for Signal (replaces default if set)",
          "x-layer": "global",
          "x-priority": "76"
        },
        "append_instructions": {
          "type": "string",
          "description": "Additional instructions appended to the default Signal agent instructions",
          "x-layer": "global",
          "x-priority": "77"
        }
      },
      "type": "object",
      "required": [
        "enabled",
        "cli_path",
        "account",
        "allowlist",
        "groups",
        "contacts",
        "agent_instructions",
        "append_instructions"
      ]
    },
    "SignalContact": {
      "properties": {
        "phone": {
          "type": "string",
          "description": "Phone number for this contact"
        },
        "instructions": {
          "type": "string",
          "description": "Custom agent instructions when targeting this contact"
        }
      },
      "type": "object",
      "required": [
        "phone",
        "instructions"
      ]
    },
    "SystemConfig": {
      "properties": {
        "levels": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Notification levels that trigger system notifications",
          "x-layer": "global",
          "x-priority": "73"
        }
      },
      "type": "object",
      "required": [
        "levels"
      ]
    }
  },
  "properties": {
    "ntfy": {
      "$ref": "#/$defs/NtfyConfig",
      "description": "ntfy.sh push notification settings",
      "x-layer": "global",
      "x-priority": "70"
    },
    "system": {
      "$ref": "#/$defs/SystemConfig",
      "description": "Native system notification settings",
      "x-layer": "global",
      "x-priority": "71"
    },
    "signal": {
      "$ref": "#/$defs/SignalConfig",
      "description": "Signal messaging channel settings",
      "x-layer": "global",
      "x-priority": "72"
    }
  },
  "type": "object",
  "title": "Grove Notifications Configuration",
  "description": "Schema for the 'notifications' extension in grove.yml."
}